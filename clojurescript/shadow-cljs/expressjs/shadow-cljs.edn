{:source-paths ["src"]

 :dependencies
 [[cider/cider-nrepl "0.58.0"]]

 :nrepl {:middleware [cider.nrepl/cider-middleware]}

 :builds {:app
          {:target :node-script
           :output-to "dist/app.js"
           :main expressjs.server.core/-main
           :dev {:output-to "build/app.js"
                 :closure-defines {expressjs.server.config/env "dev"}}
           :release {:closure-defines {expressjs.server.config/env "release"}}}}}
